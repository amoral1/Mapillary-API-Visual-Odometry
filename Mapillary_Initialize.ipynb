   "source": [
    "import requests\n",
    "import time\n",
    "from tqdm import tqdm\n",
    "import sys\n",
    "\n",
    "token = \""\n",
    "seq_id = \""\n",
    "\n",
    "url = f\"https://graph.mapillary.com/image_ids?access_token={token}&sequence_id={seq_id}\"\n",
    "response = requests.get(url)\n",
    "image_ids = [obj['id'] for obj in response.json()['data']]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "9ac585b4-8774-4e50-a3ae-8debc7ada136",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "258"
      ]
     },
     "execution_count": 9,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "len(image_ids)\n",
    "\n",
    "#image_ids[:100] or every Nth frame (image_ids[::5]) for mediating data extraction"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b0a827b3-5e09-4f2c-a3d0-a49b6deb0f36",
   "metadata": {},
   "source": [
    "**Pull Pose-trajectory for each image**\n",
    "\n",
    "of Geolocation (only), with memory readings and status"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "cb75c365-41e3-4283-a519-04b520f7f785",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Fetching poses: 100%|██████████████████████| 258/258 [01:39<00:00,  2.61image/s]"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Approximate in-memory size: 2.15 KB\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "trajectory = []\n",
    "\n",
    "for image_id in tqdm(image_ids, desc=\"Fetching poses\", unit=\"image\"):\n",
    "    url = f\"https://graph.mapillary.com/{image_id}?access_token={token}&fields=id,geometry,computed_geometry,captured_at,compass_angle,altitude\"\n",
    "    r = requests.get(url)\n",
    "    trajectory.append(r.json())\n",
    "    time.sleep(0.1)\n",
    "\n",
    "# Check memory footprint after\n",
    "print(f\"Approximate in-memory size: {sys.getsizeof(trajectory) / 1024:.2f} KB\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "71ad59b4-e7be-42b1-8069-774f9f0af53f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "RAM used: 96.56 MB\n"
     ]
    }
   ],
   "source": [
    "import psutil, os\n",
    "process = psutil.Process(os.getpid())\n",
    "print(f\"RAM used: {process.memory_info().rss / 1024**2:.2f} MB\")"
   ]
